{
  "description": "AgentBeacon status adapter for Codex CLI (plugin-bundled hooks)."
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 "${PLUGIN_ROOT}/scripts/agentbeacon_codex_hook.py""
          }
        ]
      }
    ]
  }
}
