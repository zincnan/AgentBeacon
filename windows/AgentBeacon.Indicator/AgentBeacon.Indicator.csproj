<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBeacon.Indicator</RootNamespace>
    <AssemblyName>agentbeacon-indicator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF Binding/XAML requires a real (non-invariant) culture;
         InvariantGlobalization=true crashes the app at startup with
         "Cannot find non-neutral culture related to 'en-us'" because
         WPF treats machine-preference cultures (en-US) as a specific
         culture that doesn't exist under invariant globalization.
         This is the Indicator executable only — Receiver / Shared /
         Indicator.Core / test projects keep their existing
         InvariantGlobalization setting (they don't host WPF).
         Set explicitly so Directory.Build.props can't silently
         re-introduce it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects global usings for System.Windows.Forms /
         System.Drawing which make WPF types (Application, UserControl…)
         ambiguous. Keep WinForms interop (tray icon) but opt out of its
         implicit usings; tray code uses the WinForms:: alias instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\AgentBeacon.Shared.csproj" />
    <ProjectReference Include="..\AgentBeacon.Indicator.Core\AgentBeacon.Indicator.Core.csproj" />
  </ItemGroup>

</Project>
