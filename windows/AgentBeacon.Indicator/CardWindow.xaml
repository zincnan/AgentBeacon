<Window x:Class="AgentBeacon.Indicator.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="AgentBeacon Card">
    <Border x:Name="CardBorder" Background="#F01E1E1E" CornerRadius="8"
            BorderBrush="#FF30363D" BorderThickness="1"
            Padding="14,12" MaxWidth="320">
        <StackPanel>
            <TextBlock x:Name="AgentText" FontWeight="Bold" Foreground="White" FontSize="14"/>
            <TextBlock x:Name="StatusText" Foreground="#D29922" FontSize="12"
                       Margin="0,4,0,0" FontWeight="SemiBold"/>
            <TextBlock x:Name="MessageText" Foreground="#C9D1D9" FontSize="13"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="SessionIdText" Foreground="#6E7681" FontSize="10"
                       Margin="0,8,0,0" FontFamily="Consolas,Courier New,monospace"/>
            <TextBlock x:Name="HostText" Foreground="#6E7681" FontSize="10"
                       FontFamily="Consolas,Courier New,monospace"/>
        </StackPanel>
    </Border>
</Window>
