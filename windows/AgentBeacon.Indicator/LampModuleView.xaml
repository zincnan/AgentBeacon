<UserControl x:Class="AgentBeacon.Indicator.LampModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AgentBeacon.Indicator"
             Width="{x:Static local:IndicatorUiConstants.ModuleWidth}"
             Height="{x:Static local:IndicatorUiConstants.ModuleHeight}"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="AgentLabelStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="21"/>
            <Setter Property="MaxWidth" Value="84"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#D02B2F33"/>
            <Setter Property="BorderBrush" Value="#553A4148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LampDotStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="{x:Static local:IndicatorUiConstants.LightDiameter}"/>
            <Setter Property="Height" Value="{x:Static local:IndicatorUiConstants.LightDiameter}"/>
            <Setter Property="Stroke" Value="#454B52"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Thickness x:Key="LampGapMargin"
                   Left="0"
                   Top="0"
                   Right="0"
                   Bottom="{x:Static local:IndicatorUiConstants.LightGap}"/>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="RenameItem"
                      Header="重命名此灯"/>
            <MenuItem x:Name="ResetNameItem"
                      Header="恢复默认名称"/>
            <MenuItem x:Name="DismissItem"
                      Header="关闭此灯（该会话有新状态时自动恢复）"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border Style="{StaticResource AgentLabelStyle}"
                ToolTip="{Binding TooltipText}"
                Margin="0,0,0,2">
            <Grid>
                <TextBlock x:Name="AgentLabel"
                           FontSize="10.5"
                           Foreground="#D8DEE4"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="68"
                           TextTrimming="CharacterEllipsis"/>
                <!-- 就地重命名输入框（右键 → 重命名此灯；Enter 确认 / Esc 取消） -->
                <TextBox x:Name="LabelEdit"
                         FontSize="10.5"
                         MaxLength="24"
                         MaxWidth="80"
                         Visibility="Collapsed"
                         Background="#FF15181C"
                         Foreground="#FFE6EAEE"
                         BorderBrush="#FF7A8490"
                         BorderThickness="1"
                         Padding="2,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         KeyDown="LabelEdit_KeyDown"
                         LostKeyboardFocus="LabelEdit_LostKeyboardFocus"/>
            </Grid>
        </Border>

        <Border Width="42"
                Background="#E6282C31"
                BorderBrush="#66454B52"
                BorderThickness="1"
                CornerRadius="{x:Static local:IndicatorUiConstants.ModuleCornerRadius}"
                Padding="{x:Static local:IndicatorUiConstants.ModuleHousingPadding}"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7"
                                  ShadowDepth="1"
                                  Direction="270"
                                  Opacity="0.22"
                                  Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Ellipse x:Name="TopLight"
                         Style="{StaticResource LampDotStyle}"
                         Margin="{StaticResource LampGapMargin}"/>
                <Ellipse x:Name="MiddleLight"
                         Style="{StaticResource LampDotStyle}"
                         Margin="{StaticResource LampGapMargin}"/>
                <Ellipse x:Name="BottomLight"
                         Style="{StaticResource LampDotStyle}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
